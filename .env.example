# Spline scene for the landing hero's ambient 3D layer.
#
# Read on the SERVER and passed to the client as a prop. Deliberately not
# NEXT_PUBLIC_: a CI grep fails the build on that prefix so that no key can ever
# reach the browser, and carving out an exception for a harmless value is how
# that gate acquires holes.
#
# Leave it unset and no Spline runtime is fetched at all — the hero renders its
# clause card exactly as before. Paste your own scene URL from Spline
# (File > Export > Public URL) to turn the layer on.

# Hero background image for the landing page.
#
# Drop your file in public/ and set this to its path, e.g. /hero.webp — or
# leave it unset and the hero renders as it does now, with no image request.
#
# What to generate, so it does not fight the text:
#   size      2400x1400 or wider, landscape. It is cropped to the hero and
#             anchored right, so put anything you care about on the RIGHT half.
#   subject   texture and material, not a scene. Paper fibre, ink bleed, a
#             desk surface, folded document edges, a stamped seal. Avoid a
#             horizon, a face, or any single focal point.
#   contrast  low and even. If the left two thirds has strong light/dark
#             variation it will show through the scrim and compete with the
#             headline.
#   colour    warm neutrals. The palette is paper and ink; a blue or purple
#             image will read as belonging to a different product.
#   format    WebP, quality ~72. Keep it under 300 KB or it becomes the
#             largest thing on the page.
#
# A prompt that fits: "macro photograph of warm off-white cotton paper fibre,
# soft raking light from the left, extremely shallow texture, no objects, no
# focal point, muted warm neutral tones, editorial, high resolution"
HERO_IMAGE=

# Backend. Server-side only — check:secrets fails the build on NEXT_PUBLIC_.

# Postgres connection string for the Supabase project. Use the CONNECTION
# POOLER URI (Settings > Database > Connection string > URI, pooling on), NOT
# the direct db.<ref>.supabase.co host — that one resolves to IPv6 only and
# fails as ENOTFOUND from most networks.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Delete the square brackets around [YOUR-PASSWORD]; they are placeholder
# punctuation. Percent-encode @ as %40, # as %23, / as %2F.
#
# Leave it unset and the app runs against an in-process store: fine for local
# dev and the gates, lost on restart.
DATABASE_URL=

# Signs the anonymous session cookie. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a predictable signing key is the same as none.
SESSION_SECRET=

# Gemini. Never NEXT_PUBLIC_.
GEMINI_API_KEY=
#
# Optional, comma-separated, best first. A transient failure moves to the NEXT
# model rather than asking the same one again, because on the free tier both
# the request quota and the spare capacity are per model: one can answer 429
# "quota exhausted" or 503 "high demand" while the next serves the same prompt
# in eight seconds. Leave it empty to use the built-in list.
GEMINI_MODEL=

# Protects /api/cron/purge, compared in constant time. Vercel sends it as
# "Authorization: Bearer $CRON_SECRET" on scheduled invocations.
CRON_SECRET=

# Optional. Supabase pooler TLS is encrypted but the certificate is not
# verified by default, because Node has no root for it. Paste the project CA
# here to authenticate the connection as well as encrypt it.
DATABASE_CA=
