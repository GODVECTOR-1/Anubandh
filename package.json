{
  "name": "anubandh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:fixture": "tsx scripts/check-fixture.ts",
    "check": "npm run lint && npm run test && npm run check:secrets && npm run check:fixture && npm run check:contrast && npm run check:reading && npx tsc --noEmit",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
    "check:reading": "tsx scripts/check-reading.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "check:all": "npm run check && npm run check:routes && npm run check:backend && npm run check:a11y && npm run check:hero && npm run check:backdrop && npm run check:budget",
    "check:hero": "tsx scripts/check-hero.ts",
    "check:backdrop": "tsx scripts/check-backdrop.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:backend": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/check-backend.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "test": "npm run test:server && npm run test:components",
    "test:coverage": "tsx --conditions=react-server --test --experimental-test-coverage --test-coverage-include=\"lib/session.ts\" --test-coverage-include=\"lib/ratelimit.ts\" --test-coverage-include=\"lib/job-retry.ts\" --test-coverage-include=\"lib/normalize.ts\" --test-coverage-include=\"lib/pipeline-error.ts\" --test-coverage-lines=75 --test-coverage-branches=88 --test-coverage-functions=60 \"tests/**/*.test.ts\"",
    "test:server": "tsx --conditions=react-server --test \"tests/**/*.test.ts\"",
    "test:components": "tsx --test \"tests/**/*.test.tsx\""
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
